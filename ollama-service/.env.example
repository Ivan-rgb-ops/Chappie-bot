# Puerto del servidor Node
PORT=3000

# Proveedor principal: groq | openrouter | google | deepseek
LLM_PRIMARY_PROVIDER=groq

# Clave de Groq (Principal para charla rápida y Whisper STT)
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Fallback 1: OpenRouter (Opcional - soporta modelos :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Fallback 2: Google Gemini (Opcional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Fallback 3: DeepSeek (Opcional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Integración opcional con Hermes por HTTP (apagado por defecto)
HERMES_ENABLED=false
HERMES_API_URL=http://127.0.0.1:8080/api/task
